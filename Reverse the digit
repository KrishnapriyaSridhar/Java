import java.util.*;

public class Main {
    public static void main(String[] args) {
      Scanner s = new Scanner(System.in);
      int a = s.nextInt();
      int rev=0,temp;
      int original = a;
      while(a>0){
      temp=a%10;
      rev=(rev*10)+temp;
      a/=10;
      }
      if(rev==original){
        System.out.println("YES");
      }
      else{
        System.out.println("NO");
      }
  }
}
